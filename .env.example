# Copy to .env only for reference. scripts/init_secrets.py creates database credentials automatically.
# Values are plain text, without surrounding quotes.
TELEGRAM_TOKEN=
TELEGRAM_PROXY=

# Bootstrap administrator only; an existing account is not reset on restart.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Generated automatically for a fresh installation; keep existing values with existing PVCs.
PG_PASSWORD=
CORE_DB_PASSWORD=
NOTIFY_DB_PASSWORD=
CORE_DATABASE_URL=
NOTIFY_DATABASE_URL=
SERVICE_TOKEN=

# Generated automatically; preserve the camera encryption key with the database.
CAMERA_ENCRYPTION_KEY=

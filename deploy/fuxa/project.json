  "scripts": [
    {
      "id": "s_f1_present",
      "name": "read_f1_present",
      "code": "const s=JSON.parse(value); return s.values.present ? '有料筐' : '入口空闲';",
      "sync": true,
      "mode": "SERVER",
      "parameters": [
        {
          "name": "value",
          "type": "value",
          "value": ""
        }
      ],
      "permission": 0
    },
    {

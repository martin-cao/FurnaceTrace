        }
      ],
      "permission": 0
    },
    {
      "id": "s_f1_temperatureC",
      "name": "read_f1_temperatureC",
      "code": "const s=JSON.parse(value); return Number(s.values.temperatureC).toFixed(1) + ' °C';",
      "sync": true,
      "mode": "SERVER",
      "parameters": [
        {
          "name": "value",
          "type": "value",
          "value": ""
        }
      ],
      "permission": 0
    },
    {
      "id": "s_f1_set_temperature",
      "name": "set_f1_temperature",
      "code": "const temperatureC=Number(value); if(String(value).trim()==='' || !Number.isFinite(temperatureC)) throw Error('Invalid temperature'); const state=JSON.parse($getTag('f1-temperature-state')); const now=Date.now(); const age=now-Date.parse(state.observedAt); if(!state.bootId || !Number.isFinite(age) || age>3000 || age< -1000) throw Error('Temperature sensor offline'); return JSON.stringify({commandId:require('crypto').randomUUID(),cycleId:'',deviceId:state.deviceId,furnaceId:state.furnaceId,targetBootId:state.bootId,action:'SET_TEMPERATURE',temperatureC,issuedAt:new Date(now).toISOString(),expiresAt:new Date(now+10000).toISOString()});",
      "sync": true,
      "mode": "SERVER",
      "parameters": [
        {
          "name": "value",
          "type": "value",
          "value": ""
        }
      ],
      "permission": 0
    }
  ]
